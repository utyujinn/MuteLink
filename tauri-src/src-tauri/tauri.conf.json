{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mutelink",
  "mainBinaryName": "Mutelink",
  "version": "0.1.0",
  "identifier": "com.utyujinn.mutelink",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mutelink",
        "width": 800,
        "height": 600,
        "decorations": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "utyujinn",
    "homepage": "https://github.com/utyujinn/MuteLink",
    "shortDescription": "VRChat向け音声パイプライン(音声認識→VOICEVOX読み上げ)",
    "longDescription": "マイク入力を音声認識でテキスト化し、VOICEVOX(小夜/SAYO)で読み上げ直してVB-Audio Virtual Cable経由でVRChatのマイク入力に流すツールです。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["voicevox_core"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English", "SimpChinese", "Korean"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5RDJCM0MyOTkyMkVGOEMKUldTTTd5S1p3clBTK2QrUXdveDBnbUpCS1QrSFNEQ01VTFFJM2Jxc0JBdnVKOHplVSs1S1ZxQmoK",
      "endpoints": ["https://github.com/utyujinn/MuteLink/releases/latest/download/latest.json"]
    }
  }
}
